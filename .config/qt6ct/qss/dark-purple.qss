/* Dark Purple Theme for Qt6 Apps (Calibre) */

/* Main Window Background */
QMainWindow, QDialog, QWidget {
    background-color: #0f0f1e;
    color: #e0d5ff;
}

/* Menu Bar */
QMenuBar {
    background-color: #0a0a19;
    color: #e0d5ff;
}

QMenuBar::item:selected {
    background-color: #a855f7;
    color: #0a0a19;
}

/* Menus */
QMenu {
    background-color: #0f0f1e;
    color: #e0d5ff;
    border: 1px solid #a855f7;
}

QMenu::item:selected {
    background-color: #a855f7;
    color: #0a0a19;
}

/* Toolbars */
QToolBar {
    background-color: #0a0a19;
    border: none;
}

QToolButton {
    background-color: transparent;
    color: #e0d5ff;
    border: none;
    padding: 4px;
}

QToolButton:hover {
    background-color: rgba(168, 85, 247, 0.3);
    border-radius: 4px;
}

QToolButton:pressed {
    background-color: rgba(168, 85, 247, 0.5);
}

/* Tables and Lists */
QTableView, QListView, QTreeView {
    background-color: #0f0f1e;
    alternate-background-color: #191928;
    color: #e0d5ff;
    gridline-color: #2d1b4e;
    border: 1px solid #2d1b4e;
}

QTableView::item:selected, QListView::item:selected, QTreeView::item:selected {
    background-color: #a855f7;
    color: #0a0a19;
}

QHeaderView::section {
    background-color: #191928;
    color: #a855f7;
    border: 1px solid #2d1b4e;
    padding: 4px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: rgba(25, 15, 50, 0.3);
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: rgba(168, 85, 247, 0.5);
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(168, 85, 247, 0.7);
}

QScrollBar:horizontal {
    background: rgba(25, 15, 50, 0.3);
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: rgba(168, 85, 247, 0.5);
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(168, 85, 247, 0.7);
}

/* Buttons */
QPushButton {
    background-color: rgba(168, 85, 247, 0.3);
    color: #e0d5ff;
    border: 1px solid rgba(168, 85, 247, 0.5);
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: rgba(168, 85, 247, 0.5);
}

QPushButton:pressed {
    background-color: rgba(168, 85, 247, 0.7);
}

/* Text Input */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #191928;
    color: #e0d5ff;
    border: 1px solid #2d1b4e;
    border-radius: 4px;
    padding: 4px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #a855f7;
}

/* Combobox */
QComboBox {
    background-color: #191928;
    color: #e0d5ff;
    border: 1px solid #2d1b4e;
    border-radius: 4px;
    padding: 4px;
}

QComboBox:hover {
    border: 1px solid #a855f7;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #0f0f1e;
    color: #e0d5ff;
    selection-background-color: #a855f7;
    selection-color: #0a0a19;
}

/* Status Bar */
QStatusBar {
    background-color: #0a0a19;
    color: #c8b7ff;
}

/* Progress Bar */
QProgressBar {
    background-color: #191928;
    border: 1px solid #2d1b4e;
    border-radius: 4px;
    text-align: center;
    color: #e0d5ff;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                      stop:0 #a855f7, stop:1 #3b82f6);
    border-radius: 4px;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #2d1b4e;
    background-color: #0f0f1e;
}

QTabBar::tab {
    background-color: #191928;
    color: #c8b7ff;
    border: 1px solid #2d1b4e;
    padding: 6px 12px;
}

QTabBar::tab:selected {
    background-color: #a855f7;
    color: #0a0a19;
}

QTabBar::tab:hover {
    background-color: rgba(168, 85, 247, 0.3);
}

/* Tooltips */
QToolTip {
    background-color: #191928;
    color: #e0d5ff;
    border: 1px solid #a855f7;
    border-radius: 4px;
    padding: 4px;
}
